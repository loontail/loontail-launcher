API_URL=http://localhost:1337
API_TOKEN=

# Optional — Azure AD application ID used for Microsoft sign-in (OAuth 2.0
# Authorization Code + PKCE with loopback). Each launcher distribution
# registers its own client id (see https://aka.ms/mce-reviewappid) before
# api.minecraftservices.com accepts it. Leave blank if the launcher should
# only support Strapi-account login.
MOJANG_CLIENT_ID=

# Optional — URL embedded into the `-javaagent:authlib-injector.jar=<here>`
# JVM argument when launching Minecraft. authlib-injector reports this in
# its boot log and the vanilla client uses it for online-mode auth. Falls
# back to `${API_URL}/api/yggdrasil` when unset; override only when the
# launcher's own Node-side fetch (login / skin / textures) and the JVM
# need different URLs — typically dev, where the launcher stays on plain
# HTTP and the JVM hits HTTPS through `local-ssl-proxy`:
#
#   YGGDRASIL_GAME_API_ROOT=https://localhost:1338/api/yggdrasil
YGGDRASIL_GAME_API_ROOT=
