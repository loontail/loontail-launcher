API_URL=http://localhost:8080

# Optional — Azure AD application ID used for Microsoft sign-in (OAuth 2.0
# Authorization Code + PKCE with loopback). Each launcher distribution
# registers its own client id (see https://aka.ms/mce-reviewappid) before
# api.minecraftservices.com accepts it. Leave blank if the launcher should
# only support Loontail-account login.
MOJANG_CLIENT_ID=

# Optional — base URL of the Loontail in-game network service (friends/presence/
# relay), handed to the in-game network mod at launch together with the API
# session bearer.
#
# It is served by the SAME deployment as API_URL: the bearer is minted by
# API_URL and only that origin accepts it, so a different origin here 401s every
# in-game network call. Set it to the exact value of API_URL to enable in-game
# networking; a mismatch is logged as a warning at startup.
#
# Leave blank to inject no service URL and no session token — the mod stays
# offline and no launched game JVM ever sees the bearer.
NETWORK_API_URL=

# Optional — extra comma-separated hostnames whose links are kept in build
# descriptions. The hostname of API_URL is always allowed (plus its
# subdomains); everything else is rendered as plain text.
#
# Only https:// links survive, so a plain-http dev API_URL (the default above)
# yields no clickable links at all — that is expected locally.
#
# Example: DESCRIPTION_LINK_HOSTS=discord.gg,modrinth.com,curseforge.com
DESCRIPTION_LINK_HOSTS=
