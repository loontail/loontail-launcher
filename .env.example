API_URL=http://localhost:1337
API_TOKEN=

# Optional — Azure AD application ID used for Microsoft sign-in (OAuth 2.0
# Authorization Code + PKCE with loopback). Each launcher distribution
# registers its own client id (see https://aka.ms/mce-reviewappid) before
# api.minecraftservices.com accepts it. Leave blank if the launcher should
# only support Strapi-account login.
MOJANG_CLIENT_ID=

# Optional — base URL of the Loontail in-game network service (friends/presence/
# relay) that the embedded network agent connects to. Leave blank to ship the
# overlay without network features (the agent attaches but stays offline).
NETWORK_API_URL=
