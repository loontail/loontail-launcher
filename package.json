{
  "name": "@loontail/minecraft-launcher",
  "version": "0.0.40",
  "private": true,
  "description": "Loontail Minecraft launcher.",
  "main": "out/main/index.js",
  "author": {
    "name": "Loontail",
    "email": "estluced@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loontail/loontail-launcher.git"
  },
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "abi:node": "node scripts/abi.mjs node",
    "abi:electron": "node scripts/abi.mjs electron",
    "fetch:authlib-injector": "node scripts/fetchAuthlibInjector.mjs",
    "prebuild": "npm run fetch:authlib-injector",
    "build": "electron-vite build",
    "build:win": "npm run rebuild && npm run build && electron-builder --win",
    "build:mac": "npm run rebuild && npm run build && electron-builder --mac",
    "build:linux": "npm run rebuild && npm run build && electron-builder --linux",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:i18n": "node scripts/lintI18n.mjs",
    "shots": "install-electron && electron-vite build && node scripts/screenshot.mjs",
    "shots:run": "install-electron && node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@loontail/minecraft-kit": "0.8.14",
    "better-sqlite3": "^12.11.1",
    "check-disk-space": "^3.4.0",
    "electron-log": "^5.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@electron/rebuild": "^4.2.0",
    "@fontsource/nunito": "^5.3.0",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "clsx": "^2.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.30.0",
    "marked": "^18.0.9",
    "node-abi": "^4.33.0",
    "node-gyp": "^13.0.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
