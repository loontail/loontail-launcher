{
  "name": "@loontail/minecraft-launcher",
  "version": "0.0.33",
  "private": true,
  "description": "Loontail Minecraft launcher.",
  "main": "out/main/index.js",
  "author": {
    "name": "Loontail",
    "email": "estluced@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loontail/loontail-launcher.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:i18n": "node scripts/lintI18n.mjs",
    "lint:strapi": "node scripts/diffStrapiSchemas.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.0.0",
    "@loontail/minecraft-kit": "0.8.14",
    "@loontail/yggdrasil-client": "^0.0.7",
    "@loontail/yggdrasil-core": "^0.0.7",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "@tanstack/query-sync-storage-persister": "^5.100.10",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.100.10",
    "check-disk-space": "^3.4.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "i18next": "^26.1.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.7",
    "skinview3d": "^3.4.2",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
