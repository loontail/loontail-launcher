{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "out/renderer",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "types": [],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/*"],
      "@splidejs/react-splide": ["node_modules/@splidejs/react-splide/dist/types/index.d.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/renderer/**/*.json",
    "src/shared/**/*",
    "src/preload/index.d.ts"
  ]
}
